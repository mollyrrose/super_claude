{
  "name": "repomix",
  "description": "Strip repomix XML header/footer boilerplate; keep file content.",
  "match": "repomix",
  "match_kind": "substring",
  "strategies": [
    { "type": "strip_ansi" },
    { "type": "drop_regex", "pattern": "^={10,}.*$" },
    { "type": "drop_regex", "pattern": "^File Summary$" },
    { "type": "drop_regex", "pattern": "^Repository Structure$" },
    { "type": "drop_regex", "pattern": "^This file is a merged representation" },
    { "type": "drop_regex", "pattern": "^Generated by Repomix" },
    { "type": "drop_regex", "pattern": "^<\\?xml" },
    { "type": "drop_regex", "pattern": "^<repomix>" },
    { "type": "drop_regex", "pattern": "^</repomix>" },
    { "type": "drop_regex", "pattern": "^<repository_structure>" },
    { "type": "drop_regex", "pattern": "^</repository_structure>" },
    { "type": "drop_regex", "pattern": "^<repository_files>" },
    { "type": "drop_regex", "pattern": "^</repository_files>" },
    { "type": "drop_regex", "pattern": "^Total files:.*$" },
    { "type": "drop_regex", "pattern": "^Total tokens:.*$" },
    { "type": "fold_whitespace" }
  ]
}
